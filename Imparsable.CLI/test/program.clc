const pi = 3.14;
const radius = 4 / 2;
var area = 2 * pi * radius;
var acc = "";
print "Area" + ': ' + area;
print 1 + 2;

for (var x = 0; x < 3; x += 1) {
    print x + 1;
    acc += x;
    
    if (x == 0) {
        print "1st iteration";
    } else if (x == 1) {
        print "2nd iteration";
    } else {
        print "Probably the 3rd iteration";
    }
}

print acc;

print "123" + 5;

print acc == "1235";

print "" + false == "false";

if (false || true) {
    print "|| works";
}

if (true && true) {
    print "&& works";
}

print 4 % 2;
print 5 % 2;

if (4 % 2 == 0) {
    print "Modulo works";
}
